  heading:
    chinese: "\u5143\u5E74 \xB7 \u53E4\u4FEE\u77F3\u95E8"
    english: YEAR ZERO  /  ANCIENT STONE GATE
    start: 0.5
    end: 5.95
  dialogue:
    chinese: "\u7B2C\u4E09\u5E74\uFF0C\u6E21\u53E3\u90A3\u5B69\u5B50\u4F1A\u8D70\u5230\u8FD9\u91CC\u3002"
    english: In the third year, the child from the ferry will reach this gate.
    start: 0.8
    end: 3.7
  secondDialogue:
    chinese: "\u8FD9\u4E00\u56DE\uFF0C\u4F60\u4E5F\u5728\u8DEF\u4E0A\u3002"
    english: This time, you're on the road too.
