  dialogue:
    chinese: "\u5F52\u589F\u5927\u9635\u7834\u4E86\u3002\u5B88\u5370\u4EBA\u62FF\u6D3B\u4EBA\u7684\u540D\u5B57\u8865\u9635\u3002"
    english: The Guixu formation cracked. Its keeper used living names to mend it.
    start: 0.4
    end: 3.5
  secondDialogue:
    chinese: "\u540D\u5B57\u4E00\u5165\u9635\uFF0C\u4EB2\u53CB\u4FBF\u4F1A\u5FD8\u4E86\u90A3\u4E2A\u4EBA\u3002"
    english: Once a name entered the formation, even loved ones forgot.
    start: 3.65
    end: 6.15
